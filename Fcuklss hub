    tracer.Transparency = 1
    data.tracer = tracer
end

-- CONEXÃO ÚNICA GLOBAL - evita acúmulo de conexões
local espRenderConnection = nil

local function startESPLoop()
    if espRenderConnection then return end -- Já está rodando
    
    espRenderConnection = RunService.RenderStepped:Connect(function()
        if not espEnabled then return end
        
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local cam = workspace.CurrentCamera
        
        for playerName, data in pairs(espData) do
            local player = Players:FindFirstChild(playerName)
            
            -- Se jogador saiu do jogo, limpa
            if not player then
                clearPlayerESP(playerName)
                continue
            end
            
            -- Atualiza referências se o character mudou (respawn)
            local currentChar = player.Character
            if currentChar and currentChar ~= data.character then
                -- Character novo, atualiza HRP
                local newHRP = currentChar:FindFirstChild("HumanoidRootPart")
                if newHRP then
                    data.character = currentChar
                    data.hrp = newHRP
                    data.billboard.Adornee = newHRP
                end
            end
            
            local hrp = data.hrp
            local char = data.character
            
            -- Se não tem HRP válido, esconde
            if not hrp or not hrp.Parent then
                data.billboard.Enabled = false
                data.tracer.Visible = false
                continue
            end
            
            -- Pega Humanoid atual
            local hum = char:FindFirstChildOfClass("Humanoid")
            local isDead = false
            local health = 0
            local maxHealth = 100
            
            if hum then
                health = hum.Health
                maxHealth = hum.MaxHealth
                isDead = hum.Health <= 0
            else
                isDead = true
            end
            
            -- Atualiza cores e texto
            if isDead then
                data.nameLabel.TextColor3 = Color3.fromRGB(100, 100, 100)
                data.nameLabel.Text = playerName .. " [DEAD]"
            else
                data.nameLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                data.nameLabel.Text = playerName
            end
            
            data.billboard.Enabled = espSettings.ShowName or espSettings.ShowHealth or espSettings.ShowDistance
            data.nameLabel.Visible = espSettings.ShowName
            data.hpLabel.Visible = espSettings.ShowHealth and not isDead
            data.distLabel.Visible = espSettings.ShowDistance
            
            -- Distância
            if myHRP and espSettings.ShowDistance then
                local dist = (myHRP.Position - hrp.Position).Magnitude
                data.distLabel.Text = math.floor(dist) .. " studs"
            elseif espSettings.ShowDistance then
                data.distLabel.Text = "?"
            end
            
            -- Health
            if espSettings.ShowHealth and not isDead and hum then
                local pct = maxHealth > 0 and (health / maxHealth) or 0
                data.hpLabel.Text = "❤️ " .. math.floor(health) .. "/" .. math.floor(maxHealth)
                data.hpLabel.TextColor3 = getHealthColor(pct)
            end
            
            -- Tracer
            if espSettings.ShowTracers then
                local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    data.tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                    data.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                    data.tracer.Color = isDead and Color3.fromRGB(100, 100, 100) or Color3.fromRGB(255, 50, 50)
                    data.tracer.Visible = true
                else
                    data.tracer.Visible = false
                end
            else
                data.tracer.Visible = false
            end
        end
    end)
end

local function stopESPLoop()
    if espRenderConnection then
        espRenderConnection:Disconnect()
        espRenderConnection = nil
    end
end

