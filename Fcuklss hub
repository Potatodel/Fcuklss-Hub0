-- ============ TAB: FPS BOOST ============
local TabFPS = Window:Tab({
    Title = "FPS Boost",
    Icon = "zap",
    ShowTabTitle = false,
    Border = true,
})

local fpsBoostActive = false
local originalSettings = {}
local fpsConnections = {}

local function removeDecals()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Decal") or v:IsA("Texture") then
            v:Destroy()
        elseif v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            v.Reflectance = 0
        end
    end
end

local function disableEffects()
    local Lighting = game:GetService("Lighting")
    
    -- Salva configurações originais
    originalSettings.Brightness = Lighting.Brightness
    originalSettings.GlobalShadows = Lighting.GlobalShadows
    originalSettings.FogEnd = Lighting.FogEnd
    originalSettings.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
    originalSettings.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
    
    -- Aplica configurações de performance
    Lighting.Brightness = 2
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 100000
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    
    -- Remove efeitos de iluminação
    for _, v in pairs(Lighting:GetDescendants()) do
        if v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or 
           v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
            v.Enabled = false
        end
    end
end

local function disableAnimations()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                for _, animTrack in pairs(humanoid:GetPlayingAnimationTracks()) do
                    animTrack:Stop()
                end
                humanoid.Animator:Destroy()
            end
        end
    end
end

local function disableParticles()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or 
           v:IsA("Fire") or v:IsA("Sparkles") then
            v.Enabled = false
        end
    end
end

local function disableSounds()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Sound") then
            v.Volume = 0
        end
    end
end

local function optimizeWorkspace()
    -- Remove meshes pesados desnecessários
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("MeshPart") then
            v.RenderFidelity = Enum.RenderFidelity.Performance
            v.Material = Enum.Material.SmoothPlastic
        end
    end
end

TabFPS:Toggle({
    Title = "FPS Boost",
    Desc = "Remove decals, effects, animations and optimize game",
    Icon = "zap",
    Value = false,
    Flag = "fps_boost",
    Callback = function(state)
        fpsBoostActive = state
        
        if state then
            -- Aplica todas as otimizações
            removeDecals()
            disableEffects()
            disableAnimations()
            disableParticles()
            disableSounds()
            optimizeWorkspace()
            
            -- Monitora novos objetos
            fpsConnections.descendantAdded = workspace.DescendantAdded:Connect(function(desc)
                if desc:IsA("Decal") or desc:IsA("Texture") then
                    task.wait()
                    desc:Destroy()
                elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Smoke") or 
                       desc:IsA("Fire") or desc:IsA("Sparkles") then
                    desc.Enabled = false
                elseif desc:IsA("Sound") then
                    desc.Volume = 0
                elseif desc:IsA("PostEffect") then
                    desc.Enabled = false
                elseif desc:IsA("MeshPart") then
                    desc.RenderFidelity = Enum.RenderFidelity.Performance
                end
            end)
            
            fpsConnections.playerAdded = Players.PlayerAdded:Connect(function(player)
                player.CharacterAdded:Connect(function(char)
                    if fpsBoostActive then
                        task.wait(1)
                        local humanoid = char:FindFirstChildOfClass("Humanoid")
                        if humanoid and humanoid.Animator then
                            humanoid.Animator:Destroy()
                        end
                    end
                end)
            end)
            
            -- Otimização contínua a cada 5 segundos
            fpsConnections.loop = task.spawn(function()
                while fpsBoostActive do
                    task.wait(5)
                    if fpsBoostActive then
                        disableParticles()
                        disableSounds()
                    end
                end
            end)
            
        else
            -- Desativa todas as conexões
            for _, conn in pairs(fpsConnections) do
                if typeof(conn) == "RBXScriptConnection" then
                    conn:Disconnect()
                end
            end
            fpsConnections = {}
            
            -- Restaura configurações de iluminação
            local Lighting = game:GetService("Lighting")
            if originalSettings.Brightness then
                Lighting.Brightness = originalSettings.Brightness
                Lighting.GlobalShadows = originalSettings.GlobalShadows
                Lighting.FogEnd = originalSettings.FogEnd
                Lighting.EnvironmentDiffuseScale = originalSettings.EnvironmentDiffuseScale
                Lighting.EnvironmentSpecularScale = originalSettings.EnvironmentSpecularScale
            end
            
            -- Reativa efeitos
            for _, v in pairs(Lighting:GetDescendants()) do
                if v:IsA("PostEffect") then
                    v.Enabled = true
                end
            end
            
            -- Reativa partículas
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or 
                   v:IsA("Fire") or v:IsA("Sparkles") then
                    v.Enabled = true
                elseif v:IsA("Sound") then
                    v.Volume = 1
                end
            end
        end
    end
})

