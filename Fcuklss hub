-- ===== AIMBOT AVANÇADO =====
local aimbotEnabled = false
local aimbotSettings = {
    FOV = 100,
    Smoothness = 0.1,
    WallCheck = false,
    TeamCheck = false,
    TargetBots = false
}
local aimbotGui = nil
local fovCircle = nil

local function createFOVCircle()
    if fovCircle then fovCircle:Remove() end
    fovCircle = Drawing.new("Circle")
    fovCircle.Visible = aimbotEnabled
    fovCircle.Thickness = 1.5
    fovCircle.Color = Color3.fromRGB(255, 255, 255)
    fovCircle.Transparency = 0.7
    fovCircle.Filled = false
    fovCircle.NumSides = 64
    fovCircle.Radius = aimbotSettings.FOV
end

local function updateFOVCircle()
    if fovCircle then
        fovCircle.Radius = aimbotSettings.FOV
        fovCircle.Visible = aimbotEnabled
        local cam = workspace.CurrentCamera
        fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    end
end

local function isVisible(targetPart)
    if not aimbotSettings.WallCheck then return true end
    local cam = workspace.CurrentCamera
    local origin = cam.CFrame.Position
    local direction = (targetPart.Position - origin).Unit * (targetPart.Position - origin).Magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = workspace:Raycast(origin, direction, raycastParams)
    if result then
        return result.Instance:IsDescendantOf(targetPart.Parent)
    end
    return true
end

local function isSameTeam(player)
    if not aimbotSettings.TeamCheck then return false end
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team == player.Team
    end
    return false
end

-- ========== OTIMIZAÇÃO TARGET BOTS ==========
local cachedBots = {}
local lastBotCacheUpdate = 0
local BOT_CACHE_INTERVAL = 0.5 -- Atualiza cache a cada 0.5 segundos

local function updateBotCache()
    local currentTime = tick()
    if currentTime - lastBotCacheUpdate < BOT_CACHE_INTERVAL then return end
    lastBotCacheUpdate = currentTime
    
    cachedBots = {}
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local isPlayer = false
            for _, player in pairs(Players:GetPlayers()) do
                if player.Character == obj then
                    isPlayer = true
                    break
                end
            end
            if not isPlayer and obj ~= LocalPlayer.Character then
                table.insert(cachedBots, {
                    character = obj,
                    player = nil,
                    isBot = true
                })
            end
        end
    end
end

-- Listener para novos bots entrarem no workspace
workspace.DescendantAdded:Connect(function(desc)
    if not aimbotSettings.TargetBots then return end
    task.wait(0.1) -- Pequeno delay para o model carregar completamente
    if desc:IsA("Model") and desc:FindFirstChild("Humanoid") and desc:FindFirstChild("HumanoidRootPart") then
        local isPlayer = false
        for _, player in pairs(Players:GetPlayers()) do
            if player.Character == desc then
                isPlayer = true
                break
            end
        end
        if not isPlayer and desc ~= LocalPlayer.Character then
            table.insert(cachedBots, {
                character = desc,
                player = nil,
                isBot = true
            })
        end
    end
end)

workspace.DescendantRemoving:Connect(function(desc)
    if not aimbotSettings.TargetBots then return end
    for i = #cachedBots, 1, -1 do
        if cachedBots[i].character == desc then
            table.remove(cachedBots, i)
        end
    end
end)

local function getAllTargets()
    local targets = {}
    
    -- Jogadores (sempre atualizados)
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            table.insert(targets, {
                character = player.Character,
                player = player,
                isBot = false
            })
        end
    end
    
    -- Bots (usando cache otimizado)
    if aimbotSettings.TargetBots then
        updateBotCache()
        for _, botData in pairs(cachedBots) do
            if botData.character and botData.character.Parent then
                table.insert(targets, botData)
            end
        end
    end
    
    return targets
end

local function getNearestTarget()
    local cam = workspace.CurrentCamera
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local closest, closestDist = nil, aimbotSettings.FOV

    local targets = getAllTargets()
    
    for _, targetData in pairs(targets) do
        local char = targetData.character
        local player = targetData.player
        local isBot = targetData.isBot
        
        local targetHRP = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")

        if targetHRP and hum and hum.Health > 0 then
            if player and isSameTeam(player) then continue end

            local aimPart = head or targetHRP
            local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)

            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                if dist < closestDist and isVisible(aimPart) then
                    closest = aimPart
                    closestDist = dist
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if not aimbotEnabled then 
        if fovCircle then fovCircle.Visible = false end
        return 
    end
    updateFOVCircle()

    local target = getNearestTarget()
    if target then
        local cam = workspace.CurrentCamera
        local targetCFrame = CFrame.new(cam.CFrame.Position, target.Position)
        cam.CFrame = cam.CFrame:Lerp(targetCFrame, aimbotSettings.Smoothness)
    end
end)

