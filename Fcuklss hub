-- Tabela que guarda os dados do ESP por jogador
local espData = {}

local function getHealthColor(pct)
    if pct > 0.6 then return Color3.fromRGB(50, 255, 50)
    elseif pct > 0.3 then return Color3.fromRGB(255, 200, 0)
    else return Color3.fromRGB(255, 50, 50) end
end

local function clearPlayerESP(playerName)
    local data = espData[playerName]
    if not data then return end
    
    -- Destroi Billboard
    if data.billboard then
        pcall(function() data.billboard:Destroy() end)
    end
    
    -- Remove Drawing
    if data.tracer then
        pcall(function() data.tracer:Remove() end)
    end
    
    espData[playerName] = nil
end

local function setupPlayerESP(player)
    if player == LocalPlayer then return end
    if espData[player.Name] then return end -- Já existe
    
    local char = player.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local data = {}
    espData[player.Name] = data
    
    -- Cria BillboardGui
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_" .. player.Name
    billboard.Size = UDim2.new(0, 120, 0, 55)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = hrp
    billboard.Parent = espFolder
    data.billboard = billboard
    data.hrp = hrp
    data.character = char
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.4, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextScaled = true
    nameLabel.Parent = billboard
    data.nameLabel = nameLabel
    
    local hpLabel = Instance.new("TextLabel")
    hpLabel.Size = UDim2.new(1, 0, 0.3, 0)
    hpLabel.Position = UDim2.new(0, 0, 0.4, 0)
    hpLabel.BackgroundTransparency = 1
    hpLabel.Font = Enum.Font.GothamBold
    hpLabel.TextScaled = true
    hpLabel.TextStrokeTransparency = 0
    hpLabel.Parent = billboard
    data.hpLabel = hpLabel
    
    local distLabel = Instance.new("TextLabel")
